<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- The injected sources are identical in every lib/<tfm> folder, and the consumer's own TFM
         (net10.0-windows10.0.19041.0, net10.0-android35.0, net11.0-ios...) rarely matches a folder name
         exactly, which silently compiled nothing. Always read them from the net10.0 folder;
         platform code is selected by the consumer's #if symbols. -->
    <MyLibTargetFramework>net10.0</MyLibTargetFramework>
  </PropertyGroup>
  
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true' OR '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
    <!--<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.12" />-->
    <Compile Include="$(MSBuildThisFileDirectory)..\lib\$(MyLibTargetFramework)\Blazor\**\*.cs" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseEssentieables)' == 'true'">
    <PackageReference Include="WindowsContracts.Net.Foundation.UniversalApiContract" Version="5.19041.10">
      <PrivateAssets>compile</PrivateAssets>
    </PackageReference>
    <PackageReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'"
                     Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.12.26368.2" >
      <PrivateAssets>compile</PrivateAssets>
      <ExcludeAssets>analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="0.1.0-preview.12.26421.1">
      <!--<PrivateAssets>compile</PrivateAssets>
      <ExcludeAssets>analyzers</ExcludeAssets>-->
    </PackageReference>
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1"/>
    
    <Compile Include="$(MSBuildThisFileDirectory)..\lib\$(MyLibTargetFramework)\Avalonia\**\*.avalonia.cs" Visible="false" />
      <Compile
        Include="$(MSBuildThisFileDirectory)..\lib\$(MyLibTargetFramework)\Avalonia.Controls.Maui.Essentials\**\*.cs"
        Exclude="$(MSBuildThisFileDirectory)..\lib\$(MyLibTargetFramework)\Avalonia.Controls.Maui.Essentials\**\*.Default.cs;$(MSBuildThisFileDirectory)..\lib\$(MyLibTargetFramework)\Avalonia.Controls.Maui.Essentials\**\*.Browser.cs"
        Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseEssentieables)' == 'true' AND
    $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'browser'">
    <Compile Include="$(MSBuildThisFileDirectory)..\lib\$(MyLibTargetFramework)\Avalonia.Controls.Maui.Essentials\**\*.Default.cs"
             Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseEssentieables)' == 'true' AND
    $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browser'">
    <Compile Include="$(MSBuildThisFileDirectory)..\lib\$(MyLibTargetFramework)\Avalonia.Controls.Maui.Essentials\**\*.Browser.cs"
             Visible="false" />
  </ItemGroup>

  <Target Name="CopyBlazorAssets" BeforeTargets="BeforeCompile"
        Condition="('$(UsingMicrosoftNETSdkWeb)' == 'true' OR '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true') AND Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <ItemGroup>
      <_Assets Include="$(MSBuildThisFileDirectory)..\lib\$(MyLibTargetFramework)\Blazor\BlazorEssentials.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_Assets)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\"
          SkipUnchangedFiles="true"
          Condition="Exists('@(_Assets)')" />
  </Target>
</Project>