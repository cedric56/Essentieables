<Project>
  <!--
    Imported from buildTransitive/: an app that gets Essentieables through a ProjectReference (for example
    App -> ViewModels -> Essentieables) must receive the sources too. Detection keeps that safe: projects
    that are neither Avalonia nor Blazor (the ViewModels library) get nothing.

      Blazor   : project uses Microsoft.NET.Sdk.Web or Microsoft.NET.Sdk.BlazorWebAssembly
                 (Web SDK outside the browser = Blazor Server: ESSENTIEABLES_BLAZOR_SERVER, per-circuit services)
      Avalonia : project references Avalonia (directly, transitively or via a ProjectReference)

    To override detection: <EssentieablesHost>Avalonia</EssentieablesHost>, Blazor, or None.
    In a multi-project Avalonia app (shared App library + Desktop/Android/iOS heads), set None in the
    projects that do not call UseEssentieables(), so the public types are not compiled twice (CS0436).

    The sources are added inside targets, after reference resolution: they are compiled and seen by
    IntelliSense, but never listed in Solution Explorer, so no Visible="false" is needed.
  -->
  <PropertyGroup>
    <!-- Backward compatibility with the former opt-in property. -->
    <EssentieablesHost Condition="'$(EssentieablesHost)' == '' and '$(UseEssentieables)' == 'true'">Avalonia</EssentieablesHost>
    <_EssentieablesSources>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'src'))</_EssentieablesSources>
    <_EssentieablesIsBrowser Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browser' or '$(RuntimeIdentifier)' == 'browser-wasm'">true</_EssentieablesIsBrowser>

    <_EssentieablesBlazor Condition="'$(EssentieablesHost)' == 'Blazor'">true</_EssentieablesBlazor>
    <_EssentieablesBlazor Condition="'$(EssentieablesHost)' == '' and ('$(UsingMicrosoftNETSdkWeb)' == 'true' or '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true')">true</_EssentieablesBlazor>
  </PropertyGroup>

  <!--
    The Avalonia sources need a few packages (see _EssentieablesRequiredPackage below). They cannot be added
    from here: NuGet restores with ExcludeRestorePackageImports=true, so package .targets are never imported
    during restore and any PackageReference they add is ignored. The Essentieables.Avalonia package brings
    them instead, as dependencies chosen by NuGet for each target framework; ESS0001 lists the missing ones.

    Only the code a target framework can run is compiled, so that it needs no package of another platform:
      ESSENTIEABLES_WINDOWS : the Windows ports (WinRT, Win32), on net10.0 and net10.0-windows*
      ESSENTIEABLES_LINUX   : the GTK4 Essentials of maui-labs, on net10.0
      MACOS (SDK)           : the macOS Essentials of maui-labs, on net10.0-macos
    Android, iOS and browser apps compile none of them.
  -->
  <Target Name="_EssentieablesAddSources" AfterTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <_EssentieablesAvalonia Condition="'$(EssentieablesHost)' == 'Avalonia'">true</_EssentieablesAvalonia>
      <_EssentieablesAvalonia Condition="'$(EssentieablesHost)' == '' and '@(ReferencePath->AnyHaveMetadataValue('Filename', 'Avalonia.Base'))' == 'true'">true</_EssentieablesAvalonia>
      <_EssentieablesFlavorExcluded Condition="'$(_EssentieablesIsBrowser)' == 'true'">Default</_EssentieablesFlavorExcluded>
      <_EssentieablesFlavorExcluded Condition="'$(_EssentieablesIsBrowser)' != 'true'">Browser</_EssentieablesFlavorExcluded>
      <_EssentieablesTargetPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_EssentieablesTargetPlatform>
      <_EssentieablesWindows Condition="'$(_EssentieablesTargetPlatform)' == '' or '$(_EssentieablesTargetPlatform)' == 'windows'">true</_EssentieablesWindows>
      <_EssentieablesLinux Condition="'$(_EssentieablesTargetPlatform)' == '' or '$(_EssentieablesTargetPlatform)' == 'linux'">true</_EssentieablesLinux>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_EssentieablesAvalonia)' == 'true'">
      <DefineConstants Condition="'$(_EssentieablesWindows)' == 'true'">$(DefineConstants);ESSENTIEABLES_WINDOWS</DefineConstants>
      <DefineConstants Condition="'$(_EssentieablesLinux)' == 'true'">$(DefineConstants);ESSENTIEABLES_LINUX</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(_EssentieablesAvalonia)' == 'true'">

      <!-- Required on all Avalonia targets -->
      <_EssentieablesRequiredPackage Include="Avalonia.Controls.WebView" />

      <!-- Windows contract: where the Windows ports are compiled, except net10.0-windows* (WinRT projection of the SDK) -->
      <_EssentieablesRequiredPackage
          Include="WindowsContracts.Net.Foundation.UniversalApiContract"
          Condition="'$(_EssentieablesWindows)' == 'true' AND '$(_EssentieablesTargetPlatform)' != 'windows'" />

      <!-- GTK4 Essentials: where the Linux branch is compiled -->
      <_EssentieablesRequiredPackage
          Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials"
          Condition="'$(_EssentieablesLinux)' == 'true'" />

      <!-- macOS Essentials -->
      <_EssentieablesRequiredPackage
          Include="Microsoft.Maui.Platforms.MacOS.Essentials"
          Condition="'$(_EssentieablesTargetPlatform)' == 'macos'" />

      <_EssentieablesResolvedPackage Include="@(ReferencePath->'%(NuGetPackageId)')" />

      <_EssentieablesMissingPackage
          Include="@(_EssentieablesRequiredPackage)"
          Exclude="@(_EssentieablesResolvedPackage)" />

    </ItemGroup>

    <Error Condition="'@(_EssentieablesMissingPackage)' != ''"
           Code="ESS0001"
           Text="Essentieables: the Avalonia sources need these packages for $(TargetFramework): @(_EssentieablesMissingPackage, ', '). Reference Essentieables.Avalonia in $(MSBuildProjectFile), which brings them for each target framework, or add them yourself. To keep the Avalonia sources out of this project, set &lt;EssentieablesHost&gt;None&lt;/EssentieablesHost&gt;." />

    <ItemGroup Condition="'$(_EssentieablesAvalonia)' == 'true'">
      <Compile Include="$(_EssentieablesSources)Avalonia\**\*.cs" />
      <!-- *.Default.cs (file storage) or *.Browser.cs (localStorage), as in Avalonia.Controls.Maui.Essentials -->
      <Compile Include="$(_EssentieablesSources)Avalonia.Controls.Maui.Essentials\**\*.cs"
               Exclude="$(_EssentieablesSources)Avalonia.Controls.Maui.Essentials\**\*.$(_EssentieablesFlavorExcluded).cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(_EssentieablesBlazor)' == 'true'">
      <Compile Include="$(_EssentieablesSources)Blazor\**\*.cs" />
    </ItemGroup>

    <!-- Blazor Server (Web SDK, not running in the browser): one set of services per circuit.
         Set <EssentieablesBlazorServer>false</EssentieablesBlazorServer> in a Web SDK project that only hosts
         a WebAssembly client and never renders interactive server components. -->
    <PropertyGroup Condition="'$(_EssentieablesBlazor)' == 'true'
                              and '$(EssentieablesBlazorServer)' != 'false'
                              and '$(_EssentieablesIsBrowser)' != 'true'
                              and '$(UsingMicrosoftNETSdkBlazorWebAssembly)' != 'true'
                              and ('$(UsingMicrosoftNETSdkWeb)' == 'true' or '$(EssentieablesBlazorServer)' == 'true')">
      <DefineConstants>$(DefineConstants);ESSENTIEABLES_BLAZOR_SERVER</DefineConstants>
    </PropertyGroup>
  </Target>

  <!-- Blazor: the JS module is imported from ./BlazorEssentials.js, so it is copied to wwwroot/. -->
  <Target Name="_EssentieablesCopyBlazorAssets" BeforeTargets="BeforeBuild"
          Condition="'$(_EssentieablesBlazor)' == 'true' and Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <Copy SourceFiles="$(_EssentieablesSources)Blazor\BlazorEssentials.js"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\"
          SkipUnchangedFiles="true" />
    <!-- wwwroot/ is globbed at evaluation: on the first build the copied file is not a Content item yet,
         so it would only be served from the second build on. -->
    <ItemGroup>
      <Content Remove="wwwroot\BlazorEssentials.js" />
      <Content Include="wwwroot\BlazorEssentials.js" />
    </ItemGroup>
  </Target>
</Project>
