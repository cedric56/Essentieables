<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Essentieables.Avalonia</id>
    <version>$version$</version>
    <authors>Cedric Boutin</authors>
    <copyright>Copyright (c) 2026 Cedric Boutin</copyright>
    <description>Essentieables for an Avalonia app: Essentieables and the packages its Avalonia sources use, for each target framework (GTK4 Essentials and the Windows contracts on net10.0 only, the macOS Essentials on net10.0-macos, Microsoft.JSInterop in the browser, nothing more on Android and iOS).</description>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <tags>maui essentials avalonia</tags>
    <dependencies>
      <!-- Platform versions as low as possible: every platform version of an app matches its group (an app on a lower version than a group
           would fall back to the net10.0 group and get the desktop packages). -->
      <!-- Desktop, any OS: the Windows ports and the GTK4 Essentials are compiled, the OS is chosen at run time. -->
      <group targetFramework="net10.0">
        <dependency id="Essentieables" version="$version$" />
        <dependency id="Avalonia.Controls.WebView" version="12.1.1" />
        <dependency id="WindowsContracts.Net.Foundation.UniversalApiContract" version="5.19041.10" />
        <dependency id="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" version="0.1.0-preview.12.26421.1" />
      </group>
      <!-- The SDK projects WinRT: no contract package. 10.0.17763 is the lowest Windows SDK version .NET 10 supports. -->
      <group targetFramework="net10.0-windows10.0.17763.0">
        <dependency id="Essentieables" version="$version$" />
        <dependency id="Avalonia.Controls.WebView" version="12.1.1" />
      </group>
      <group targetFramework="net10.0-macos1.0">
        <dependency id="Essentieables" version="$version$" />
        <dependency id="Avalonia.Controls.WebView" version="12.1.1" />
        <dependency id="Microsoft.Maui.Platforms.MacOS.Essentials" version="0.1.0-preview.12.26368.2" exclude="Analyzers" />
      </group>
      <group targetFramework="net10.0-android1.0">
        <dependency id="Essentieables" version="$version$" />
        <dependency id="Avalonia.Controls.WebView" version="12.1.1" />
      </group>
      <group targetFramework="net10.0-ios1.0">
        <dependency id="Essentieables" version="$version$" />
        <dependency id="Avalonia.Controls.WebView" version="12.1.1" />
      </group>
      <group targetFramework="net10.0-maccatalyst1.0">
        <dependency id="Essentieables" version="$version$" />
        <dependency id="Avalonia.Controls.WebView" version="12.1.1" />
      </group>
      <!-- Avalonia.Browser runs the browser implementations shared with Blazor: they use IJSRuntime (AvaloniaBrowserJSRuntime). -->
      <group targetFramework="net10.0-browser1.0">
        <dependency id="Essentieables" version="$version$" />
        <dependency id="Avalonia.Controls.WebView" version="12.1.1" />
        <dependency id="Microsoft.JSInterop" version="10.0.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="README.md" target="" />
  </files>
</package>
