<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Essentieables.Avalonia: no code, only the packages the Avalonia sources of Essentieables use, chosen by NuGet for each target framework
    of the app (Essentieables.Avalonia.nuspec). Packed from the nuspec, so no workload is needed for the platform groups.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0-preview.1</Version>
    <PackageId>Essentieables.Avalonia</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuspecFile>Essentieables.Avalonia.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version)</NuspecProperties>
    <!-- NU5128: the dependency groups have no lib/ folder, on purpose (the package has no assembly). -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

</Project>
