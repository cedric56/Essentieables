<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>
      net10.0;
      net10.0-browser;
      net10.0-ios;
      net10.0-android;
      net10.0-macos;
      net10.0-windows10.0.19041
    </TargetFrameworks>
    <!-- Builds a subset, e.g. CI builds one platform per runner. Set it as an environment variable
         (EssentieablesTargetFrameworks="net10.0;net10.0-android"): on the command line, -p: splits
         values on ';' and ',' (MSB1006). A single TFM can be passed with -p:. -->
    <TargetFrameworks Condition="'$(EssentieablesTargetFrameworks)' != ''">$(EssentieablesTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsLinuxOS Condition="$([MSBuild]::IsOSPlatform('linux'))">true</IsLinuxOS>
    <IsWindowsOS>$([MSBuild]::IsOSPlatform('windows'))</IsWindowsOS>
    <IsAndroidTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-android'))</IsAndroidTFM>
    <IsIosTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-ios'))</IsIosTFM>
    <IsMacTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-macos'))</IsMacTFM>
    <!--<IsBrowserTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-browser'))</IsBrowserTFM>-->
    <IsWindowsTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))</IsWindowsTFM>
    <!--<TreatWarningsAsErrors>true</TreatWarningsAsErrors-->
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0-preview.1</Version>
    <PackageId>Essentieables</PackageId>
    <Authors>Cedric Boutin</Authors>
    <Copyright>Copyright (c) 2026 Cedric Boutin</Copyright>
    <Description>Maui essentials on Maui/Blazor/Avalonia</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- tests/ holds separate projects: keep them out of the library's default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <SupportedOSPlatformVersion Condition="'$(IsAndroidTFM)' == 'true'">24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Required by the MIT and Apache-2.0 notices of the incorporated components. -->
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <!-- buildTransitive/: the app usually gets the package through its ViewModels project.
         The targets detect Avalonia/Blazor, so other projects in the chain are not affected. -->
    <None Include="build\Essentieables.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Host sources are compiled by the consuming app, not by this library. They are packed once
       under src/ (not once per TFM): build/Essentieables.targets picks them from there. -->
  <ItemGroup>
    <Compile Remove="Blazor\**;Avalonia\**;Avalonia.Controls.Maui.Essentials\**" />
    <None Remove="Blazor\**;Avalonia\**;Avalonia.Controls.Maui.Essentials\**" />
    <None Include="Blazor\**\*.cs;Blazor\**\*.js" Pack="true" PackagePath="src\Blazor\%(RecursiveDir)" />
    <None Include="Avalonia\**\*.cs" Pack="true" PackagePath="src\Avalonia\%(RecursiveDir)" />
    <None Include="Avalonia.Controls.Maui.Essentials\**\*.cs" Pack="true" PackagePath="src\Avalonia.Controls.Maui.Essentials\%(RecursiveDir)" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindowsTFM)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <!-- Browser -->
  <!--<ItemGroup Condition="'$(IsBrowserTFM)' == 'true'">
    <Compile Include="**\*.browser.cs" />
  </ItemGroup>-->

  <!-- macOS -->
  <ItemGroup Condition="'$(IsMacTFM)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.12.26368.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsLinuxOS)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="0.1.0-preview.12.26421.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.120" />
  </ItemGroup>
</Project>
