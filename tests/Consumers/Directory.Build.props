<Project>
  <!-- Consumer projects restore the Essentieables package produced by the CI "pack" step
       (dotnet pack -o artifacts/packages -p:Version=$(EssentieablesVersion)). -->
  <PropertyGroup>
    <EssentieablesVersion Condition="'$(EssentieablesVersion)' == ''">1.0.0-local</EssentieablesVersion>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../artifacts/packages</RestoreAdditionalProjectSources>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
  </PropertyGroup>

  <!-- The packages the Essentieables Avalonia sources need, for each target framework: what an Avalonia app references.
       An Android, iOS or browser consumer must build without any Windows or GTK4 package (ESS0001 would list a missing one). -->
  <ItemGroup Condition="'$(EssentieablesAvaloniaConsumer)' == 'true'">
    <PackageReference Include="Essentieables.Avalonia" Version="$(EssentieablesVersion)" />
  </ItemGroup>
</Project>
