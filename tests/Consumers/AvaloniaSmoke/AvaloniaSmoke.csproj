<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs UseEssentieables() in a headless Avalonia app on the CI host OS (Windows, Linux or macOS)
       and exercises the services every desktop host must provide. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseEssentieables>true</UseEssentieables>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Essentieables" Version="$(EssentieablesVersion)" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

</Project>
