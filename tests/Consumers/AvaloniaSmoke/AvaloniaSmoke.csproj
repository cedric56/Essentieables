<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs UseEssentieables() in a headless Avalonia app on the CI host OS (Windows, Linux or macOS)
       and exercises the services every desktop host must provide. -->
  <PropertyGroup>
    <EssentieablesAvaloniaConsumer>true</EssentieablesAvaloniaConsumer>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Essentieables comes through Essentieables.Avalonia (Directory.Build.props), as in an Avalonia app. -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

</Project>
