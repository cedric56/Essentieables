<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compile-only check: the package injects its Avalonia sources into the consumer, so they must
       compile for every target framework a consumer may use. CI passes the TFM for its platform:
       dotnet build -f net10.0-android | net10.0-ios | net10.0-macos | net10.0-windows10.0.19041.0 | net10.0 -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(ConsumerTargetFrameworks)' != ''">$(ConsumerTargetFrameworks)</TargetFrameworks>
    <UseEssentieables>true</UseEssentieables>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Essentieables" Version="$(EssentieablesVersion)" />
  </ItemGroup>

</Project>
